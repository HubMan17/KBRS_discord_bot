# KBRS Discord Bot Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ============================================================================
# Discord Configuration
# ============================================================================
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_IDS=1234567890123456789
DISCORD_SYNC_SLASH=true

# Discord Channels
DISCORD_ALLOWED_COMMAND_CHANNELS=1234567890123456789
DISCORD_LEVEL_UP_LOG_CHANNEL_ID=1234567890123456789
DISCORD_LEVEL_UP_PUBLIC_IN_SAME_CHANNEL=false
DISCORD_WELCOME_CHANNEL_ID=1234567890123456789
DISCORD_ANNOUNCEMENT_CHANNEL_ID=1234567890123456789

# Language-specific channels
DISCORD_ENGLISH_CHAT_ID=1234567890123456789
DISCORD_JAPANESE_CHAT_ID=1234567890123456789
DISCORD_KOREAN_CHAT_ID=1234567890123456789
DISCORD_RUSSIAN_CHAT_ID=1234567890123456789
DISCORD_TAIWAN_CHAT_ID=1234567890123456789

# ============================================================================
# Telegram Configuration
# ============================================================================
TG_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TG_CHAT_ID=-1001234567890
TG_THREAD_ID=4
TG_TOPIC_HW=3
TG_TOPIC_FACTS=2
TG_WATCHER_USERNAMES=User1,User2
TG_START_POLLING=1
TG_DISABLE_SEND=0

# ============================================================================
# Backend API Configuration
# ============================================================================
API_BASE_URL=http://127.0.0.1:8000/api/v1/
# For production, use HTTPS:
# API_BASE_URL=https://your-domain.com/api/v1/

API_USERNAME=bot_user
API_PASSWORD=your_secure_password_here_minimum_32_chars

# API Behavior
API_TIMEOUT=10
API_TOKEN_LIFETIME=1500
API_MAX_RETRIES=3
API_RETRY_DELAY=1.0

# ============================================================================
# Translation Service (DeepSeek AI)
# ============================================================================
DEEP_ENABLED=1
DEEP_URL=https://api.intelligence.io.solutions/api/v1/chat/completions
DEEP_KEY=your_deepseek_api_key_here
DEEP_MODEL=deepseek-ai/DeepSeek-R1-0528

# Translation timeouts (in seconds)
DEEP_TIMEOUT_EN=30
DEEP_TIMEOUT_ZH=40
DEEP_TIMEOUT_JA=30
DEEP_TIMEOUT_RU=30
DEEP_TIMEOUT_KO=30
DEEP_MAX_ATTEMPTS=4
DEEP_BASE_DELAY=0.6

# ============================================================================
# Discord Relay Configuration
# ============================================================================
RELAY_ENABLED=1
RELAY_SEND_TEXT_FIRST=1
RELAY_MODE=BEST_EFFORT
RELAY_DS_THREAD_ID=1234567890123456789
RELAY_DS_TOPIC_HW=1234567890123456789

# ============================================================================
# XP System Configuration
# ============================================================================
XP_PER_MESSAGE_MIN=8
XP_PER_MESSAGE_MAX=15
XP_MESSAGE_COOLDOWN=45

XP_ENABLE_REACTION_XP=true
XP_PER_REACTION_MIN=3
XP_PER_REACTION_MAX=6
XP_REACTION_COOLDOWN=45
XP_DISALLOW_SELF_REACT=true

XP_BONUS_STICKER=5
XP_BONUS_ATTACHMENT=8
XP_BONUS_REPLY=5

# ============================================================================
# Database Configuration
# ============================================================================
DB_PATH=bridge.db
DB_WAL_MODE=true
DB_MAX_CONNECTIONS=10
DB_TIMEOUT=5.0

# ============================================================================
# Event Buffer Configuration
# ============================================================================
BUFFER_SAFE_MAX=2000
BUFFER_FLUSH_PERIOD=300

# ============================================================================
# Feature Flags
# ============================================================================
ENABLE_TG_BRIDGE=1
ENABLE_DISCORD_RELAY=1
ENABLE_TRANSLATION=1

# ============================================================================
# Application Configuration
# ============================================================================
ENVIRONMENT=production
DEBUG=false

# Logging
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_TO_CONSOLE=true

# ============================================================================
# Legacy/Optional Settings
# ============================================================================
# Role IDs for rank cards
LANG_ROLE_IDS_JA=1234567890123456789
LANG_ROLE_IDS_DE=1234567890123456789
LANG_ROLE_IDS_ZH_CN=1234567890123456789

# Mention reply settings
MENTION_REPLY_COOLDOWN=10
MENTION_ONLY_AT_START=true
MENTION_STICKER_ID=0
MENTION_EMOJI_ID=1234567890123456789
MENTION_EMOJI_NAME=your_emoji_name

# Activity tracking
ACTIVITY_ID=1234567890123456789
ACTIVITY_VOICE_CHANNEL_ID=1234567890123456789

# Homework channels
HOMEWORK=1234567890123456789
